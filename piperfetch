def visible_width(text: str) -> int:
    return len(ANSI_RE.sub("", text))


def run(cmd: list[str], timeout: float = 1.0) -> str:
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return proc.stdout.strip()


def module(key: str, value: str | None) -> str | None:
    if value is None or value == "":
        return None
    return f"{KEY}{key}{RESET}: {value}"


def human_bytes(size: float) -> str:
    units = ("B", "KiB", "MiB", "GiB", "TiB", "PiB")
    value = float(size)
    for unit in units:
        if value < 1024 or unit == units[-1]:
            if unit == "B":
                return f"{value:.0f} {unit}"
            return f"{value:.2f} {unit}"
        value /= 1024
    return f"{value:.2f} PiB"


def duration(seconds: float) -> str:
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds} secs"
    minutes = seconds // 60
    if minutes < 60:
        return f"{minutes} mins"
    hours, minutes = divmod(minutes, 60)
    return f"{hours} hours, {minutes} mins"


def read_text(path: str) -> str:
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


def os_release() -> str:
    values: dict[str, str] = {}
    for line in read_text("/etc/os-release").splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            values[key] = value.strip().strip('"')
    return values.get("PRETTY_NAME") or values.get("NAME") or "Linux"


def uptime() -> str:
    try:
        seconds = float(read_text("/proc/uptime").split()[0])
    except (IndexError, ValueError):
        return ""
    return duration(seconds)


def package_count() -> str:
    pacman = 0
    pacman_dir = Path("/var/lib/pacman/local")
    try:
        pacman = sum(1 for p in pacman_dir.iterdir() if p.is_dir())
    except OSError:
        pass

    flatpak = 0
    for root in (Path.home() / ".local/share/flatpak/app", Path("/var/lib/flatpak/app")):
        try:
            flatpak += sum(1 for p in root.iterdir() if p.is_dir())
        except OSError:
            pass

    parts = []
    if flatpak:
        parts.append(f"{flatpak} (flatpak)")
    if pacman:
        parts.append(f"{pacman} (pacman)")
    return ", ".join(parts)


def shell_name() -> str:
    shell = Path(os.environ.get("SHELL", "sh")).name
    version = ""
    try:
        out = run([shell, "--version"], timeout=0.5).splitlines()
        if out:
            match = re.search(r"(\d+\.\d+(?:\.\d+)?)", out[0])
            if match:
                version = f" {match.group(1)}"
    except OSError:
        pass
    return f"{shell}{version}"


def displays() -> list[tuple[str, str]]:
    output = run(["niri", "msg", "outputs"], timeout=1.0)
    if not output:
        return []

    lines = output.splitlines()
    result: list[tuple[str, str]] = []
    for index, line in enumerate(lines):
        match = re.match(r'Output\s+".*"\s+\((DP-\d+|HDMI-\d+|eDP-\d+)\)', line)
        if not match:
            continue
        connector = match.group(1)
        mode = ""
        for nxt in lines[index + 1:index + 8]:
            found = re.search(r"Current mode:\s*(\d+x\d+)\s*@\s*([\d.]+)\s*Hz", nxt)
            if found:
                mode = f"{found.group(1)} @ {float(found.group(2)):.0f} Hz"
                break
        result.append((connector, mode))
    return result


def window_manager() -> str:
    version = run(["niri", "msg", "version"], timeout=1.0)
    match = re.search(r"Compositor version:\s*([^\s]+)", version)
    if match:
        return f"niri {match.group(1)} (Wayland)"
    return ""


def gsettings(schema: str, key: str) -> str:
    value = run(["gsettings", "get", schema, key], timeout=0.8)
    return value.strip().strip("'")


def desktop_theme() -> str:
    theme = gsettings("org.gnome.desktop.interface", "gtk-theme")
    return f"{theme} [GTK3/4]" if theme else ""


def desktop_font() -> str:
    value = gsettings("org.gnome.desktop.interface", "font-name")
    if not value:
        return ""
    parts = value.rsplit(" ", 1)
    if len(parts) == 2 and re.match(r"[\d.]+$", parts[1]):
        return f"{parts[0]} ({parts[1]}pt) [GTK3/4]"
    return f"{value} [GTK3/4]"


def desktop_cursor() -> str:
    theme = gsettings("org.gnome.desktop.interface", "cursor-theme")
    size = gsettings("org.gnome.desktop.interface", "cursor-size")
    if not theme:
        return ""
    return f"{theme} ({size}px)" if size else theme


def terminal_name() -> str:
    if os.environ.get("KITTY_WINDOW_ID") or "kitty" in os.environ.get("TERM", ""):
        version = run(["kitty", "--version"], timeout=0.5).splitlines()
        if version:
            return " ".join(version[0].split()[:2])
        return "kitty"
    return os.environ.get("TERM", "")


def terminal_font() -> str:
    conf = Path.home() / ".config/kitty/kitty.conf"
    if not conf.exists():
        return ""
    family = ""
    size = ""
    try:
        for line in conf.read_text(errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(None, 1)
            if len(parts) != 2:
                continue
            if parts[0] == "font_family":
                family = parts[1].strip()
            elif parts[0] == "font_size":
                size = parts[1].strip()
    except OSError:
        return ""
    if not family:
        return ""
    return f"{family} ({size}pt)" if size else family


def cpu_info() -> str:
    lscpu = run(["lscpu"], timeout=1.0)
    if not lscpu:
        return ""

    values: dict[str, str] = {}
    for line in lscpu.splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            values[key.strip()] = value.strip()

    model = re.sub(r"\s+", " ", values.get("Model name", "")).strip()
    if not model:
        return ""
    try:
        threads = int(values.get("CPU(s)", "0"))
    except ValueError:
        threads = 0
    try:
        cores_per_socket = int(values.get("Core(s) per socket", "0"))
        sockets = int(values.get("Socket(s)", "1"))
        cores = cores_per_socket * sockets
    except ValueError:
        cores = 0

    if cores and threads and cores != threads:
        count = f"({cores}C/{threads}T)"
    elif threads:
        count = f"({threads})"
    else:
        count = ""

    freq = ""
    try:
        mhz = float(values.get("CPU max MHz", "0"))
        if mhz:
            freq = f" @ {mhz / 1000:.2f} GHz"
    except ValueError:
        pass
    if not freq:
        try:
            khz = int(read_text("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq").strip())
            if khz:
                freq = f" @ {khz / 1_000_000:.2f} GHz"
        except ValueError:
            pass
    return f"{model} {count}{freq}".strip()


def gpu_info() -> list[str]:
    output = run(["lspci"], timeout=1.0)
    if not output:
        return []

    result: list[str] = []
    for line in output.splitlines():
        if not re.search(r"(VGA compatible controller|3D controller|Display controller)", line):
            continue
        name = line.split(": ", 1)[-1]
        name = re.sub(r"\s*\[[0-9a-fA-F]{4}:[0-9a-fA-F]{4}\]", "", name)
        name = re.sub(r"\s+", " ", name).strip()
        if not name:
            continue

        vendor = (
            "NVIDIA" if "NVIDIA" in name
            else "Intel" if "Intel" in name
            else "AMD" if ("AMD" in name or "ATI" in name)
            else ""
        )
        if "NVIDIA" in name or "AMD" in name or "ATI" in name:
            kind = "Discrete"
        elif "Intel" in name:
            kind = "Integrated"
        else:
            kind = "GPU"

        bracket = re.search(r"\[([^\]]+)\]", name)
        if bracket:
            short = bracket.group(1).strip()
            if vendor and not short.lower().startswith(vendor.lower()):
                short = f"{vendor} {short}"
            name = short
        else:
            name = re.sub(r"^(NVIDIA|Intel|AMD|ATI) Corporation\s+", "", name)
            name = re.sub(r"\s*\(rev [0-9a-fA-F]+\)", "", name).strip()

        result.append(f"{name} [{kind}]")
    return result


def memory_info() -> tuple[str, str]:
    values: dict[str, int] = {}
    for line in read_text("/proc/meminfo").splitlines():
        if ":" in line:
            key, rest = line.split(":", 1)
            try:
                values[key] = int(rest.split()[0])  # kB
            except (IndexError, ValueError):
                pass

    total = values.get("MemTotal", 0) * 1024
    available = values.get("MemAvailable", 0) * 1024
    used = max(total - available, 0)
    percent = int(round(used * 100 / total)) if total else 0
    memory = f"{human_bytes(used)} / {human_bytes(total)} ({percent}%)" if total else ""

    swap_total = values.get("SwapTotal", 0) * 1024
    swap_free = values.get("SwapFree", 0) * 1024
    swap_used = max(swap_total - swap_free, 0)
    swap_percent = int(round(swap_used * 100 / swap_total)) if swap_total else 0
    swap = (
        f"{human_bytes(swap_used)} / {human_bytes(swap_total)} ({swap_percent}%)"
        if swap_total else ""
    )
    return memory, swap


def disk_info() -> str:
    try:
        stat = os.statvfs("/")
    except OSError:
        return ""
    total = stat.f_blocks * stat.f_frsize
    free = stat.f_bavail * stat.f_frsize
    used = total - free
    percent = int(round(used * 100 / total)) if total else 0
    fstype = ""
    for line in read_text("/proc/mounts").splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[1] == "/":
            fstype = parts[2]
            break
    suffix = f" - {fstype}" if fstype else ""
    return f"{human_bytes(used)} / {human_bytes(total)} ({percent}%){suffix}"


def local_ip() -> tuple[str, str] | None:
    output = run(["ip", "-4", "-o", "addr", "show", "scope", "global"], timeout=1.0)
    for line in output.splitlines():
        match = re.search(r"^\d+:\s+(\S+)\s+inet\s+(\d+\.\d+\.\d+\.\d+/\d+)", line)
        if match and match.group(1) != "lo":
            return match.group(1), match.group(2)
    return None


def color_line(base: int) -> str:
    return "".join(f"\x1b[{base + i}m   " for i in range(8)) + RESET


