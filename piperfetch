#!/usr/bin/env python3
"""piperfetch - a small, self-contained fastfetch-like terminal dashboard.

The top of the terminal is a fixed dashboard: live pipes on the left and
system information on the right.  The shell runs below it, so the prompt is
usable immediately.  The animation runs in a separate forked process and never
reads stdin.

This file intentionally uses only the Python standard library.
"""

from __future__ import annotations

import getpass
import fcntl
import os
import random
import re
import shutil
import signal
import socket
import struct
import subprocess
import sys
import termios
import time
import tomllib
from pathlib import Path

RESET = "\x1b[0m"
BOLD = "\x1b[1m"
TITLE = "\x1b[1;32m"
KEY = "\x1b[1;36m"
BORDER = "\x1b[1;37m"

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
PIPES = "│╭ ╮╯─╮  ╰│╯╰ ╭─"
PIPE_COLORS = (1, 2, 3, 4, 5, 6, 7)  # no black
DEFAULT_FPS = 38                     # pipes.sh default is 75
GAP = 2
CLOCK_COLOR = "\x1b[1;97m"

CONFIG_DEFAULTS = {
    "specs": True,
    "autosize": True,
    "width": 54,
    "height": 22,
    "max_width": 0,
    "max_height": 0,
    "align": "left",
    "clock": False,
    "clock_size": 1,
    "clock_format": "%H:%M:%S",
    "fps": DEFAULT_FPS,
    "shell_rows": 8,
}


def config_path() -> Path:
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base / "piperfetch" / "config.toml"


def load_config() -> dict:
    cfg = dict(CONFIG_DEFAULTS)
    path = config_path()
    try:
        with path.open("rb") as handle:
            data = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError):
        return cfg

    for key in ("specs", "autosize", "clock"):
        if isinstance(data.get(key), bool):
            cfg[key] = data[key]
    for key in ("width", "height"):
        value = data.get(key)
        if isinstance(value, int) and value > 0:
            cfg[key] = value
    for key in ("max_width", "max_height", "shell_rows"):
        value = data.get(key)
        if isinstance(value, int) and value >= 0:
            cfg[key] = value
    if isinstance(data.get("fps"), int) and 1 <= data["fps"] <= 240:
        cfg["fps"] = data["fps"]
    if isinstance(data.get("clock_size"), int) and 1 <= data["clock_size"] <= 3:
        cfg["clock_size"] = data["clock_size"]
    if isinstance(data.get("align"), str):
        align = data["align"].lower()
        if align in ("left", "center", "right"):
            cfg["align"] = align
    if isinstance(data.get("clock_format"), str) and data["clock_format"]:
        cfg["clock_format"] = data["clock_format"]
    return cfg


def terminal_geometry() -> tuple[int, int, int, int]:
    """Return columns, rows, pixel width, pixel height."""
    cols = rows = xpix = ypix = 0
    try:
        data = fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, xpix, ypix = struct.unpack("HHHH", data)
    except OSError:
        pass
    if cols <= 0 or rows <= 0:
        size = shutil.get_terminal_size(fallback=(120, 40))
        cols, rows = size.columns, size.lines
    return cols, rows, xpix, ypix


def configured_limits(cfg: dict, cols: int, rows: int, xpix: int, ypix: int):
    max_cols = cols
    max_rows = rows
    if cfg["max_width"] > 0 and cols > 0 and xpix > 0:
        max_cols = max(1, int(cfg["max_width"] * cols / xpix))
    if cfg["max_height"] > 0 and rows > 0 and ypix > 0:
        max_rows = max(1, int(cfg["max_height"] * rows / ypix))
    return max_cols, max_rows



